# Neon Postgres connection string (Vercel: set in project env vars)
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Auth.js — generate with: npx auth secret
AUTH_SECRET=""

# Google OAuth credentials (https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI: <origin>/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Comma-separated emails allowed to sign in
ALLOWED_EMAILS="you@example.com"

# Anthropic API key — server-side only, never exposed to the client
ANTHROPIC_API_KEY=""
